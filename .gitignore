# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor & IDE files
.vscode/
.idea/
*.swp
*.swo

# Operating System artifacts
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Secrets & local env files
.env
.env.*
!.env.example

# Runtime logs
*.log

# Generated outputs (preserve outputs directory structure via .gitkeep)
outputs/*
!outputs/.gitkeep

# Explicit decision: Do NOT blanket-ignore spreadsheets (.xlsx, .csv).
# Data files in data/ must remain trackable for research provenance.
